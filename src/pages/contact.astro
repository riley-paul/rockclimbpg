---
import MarkdownLayout from "@/layouts/markdown-layout.astro";
import RootLayout from "@/layouts/root-layout.astro";
import { TextField, TextArea, Button, Text } from "@radix-ui/themes";
import { SendIcon } from "lucide-react";
---

<RootLayout title="Contact">
  <MarkdownLayout>
    <h1>Contact</h1>
    <p>Have some updated beta? Drop us a line and we'll get it on the site</p>
    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="grid gap-6 not-prose"
    >
      <input
        type="hidden"
        name="access_key"
        value="c75198ff-0fbb-4e0b-913c-d2b27c8e9b1d"
      />
      <Text as="label" size="2" weight="medium" className="grid gap-2">
        Name
        <TextField.Root placeholder="Alex Honnold" required />
      </Text>
      <Text as="label" size="2" weight="medium" className="grid gap-2">
        Email
        <TextField.Root placeholder="alex@freesolo.com" type="email" required />
      </Text>
      <Text as="label" size="2" weight="medium" className="grid gap-2">
        Message
        <TextArea
          name="message"
          placeholder="What's with all the bolts?"
          required
        />
      </Text>
      <footer class="flex justify-end">
        <Button type="submit" variant="surface">
          <span>Submit</span>
          <SendIcon className="size-4" />
        </Button>
      </footer>
    </form>
  </MarkdownLayout>
</RootLayout>
